{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Aura Help Center",
  "colors": {
    "primary": "#0EA5E9",
    "light": "#38BDF8",
    "dark": "#0284C7"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "icon": "rocket",
        "pages": [
          "welcome",
          "get-started/first-steps",
          "get-started/about"
        ]
      },
      {
        "group": "Chat with Aura",
        "icon": "messages-square",
        "pages": [
          "chat/modes",
          "chat/work-mode",
          "chat/voice",
          "chat/projects"
        ]
      },
      {
        "group": "Build and create",
        "icon": "hammer",
        "pages": [
          "build/agents",
          "build/ai-app-builder",
          "build/ai-studio"
        ]
      },
      {
        "group": "Account, privacy & billing",
        "icon": "shield-check",
        "pages": [
          "account/privacy",
          "account/plans",
          "account/support"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@youniverse.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Aura",
      "href": "https://aura.youniverse.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://youniverse.ai"
    }
  },
  "description": "Guides and support for Aura by Youniverse.AI — chat modes, Work Mode, voice, Agents, AI App Builder, AI Studio, privacy and billing.",
  "redirects": [
    {
      "source": "/",
      "destination": "/welcome"
    }
  ]
}
